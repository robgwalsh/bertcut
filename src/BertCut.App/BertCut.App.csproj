<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- BertCut.exe, not BertCut.App.exe. It is the file vpk is told is the main executable,
         what the installed shortcut points at, and what a user associates .mp4 with. -->
    <AssemblyName>BertCut</AssemblyName>
    <StartupObject>BertCut.App.App</StartupObject>

    <!-- Conditional so the tree still builds before the icon lands. Once it exists this is
         the Explorer and taskbar icon, and the workflows hand the same file to vpk for the
         installer. -->
    <ApplicationIcon Condition="Exists('Assets\app.ico')">Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- App.xaml is a Page rather than the ApplicationDefinition, which is what suppresses the
       generated entry point so our own Main can run VelopackApp.Build().Run() before any WPF
       startup. InitializeComponent is still generated, so the harness — which constructs App
       directly and never calls Main — is unaffected. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BertCut.Media\BertCut.Media.csproj" />
    <ProjectReference Include="..\BertCut.Core\BertCut.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UI harness hosts this window offscreen and drives it through the same dispatch
         point the keyboard does. Seeing the internals is what lets it assert against the
         real named elements instead of a parallel set of accessors. -->
    <InternalsVisibleTo Include="BertCut.Harness" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the FFmpeg build beside the executable. One copy serves both the in-process
         decoder (the shared libraries) and export (ffmpeg.exe), which is what keeps the
         preview and the exported file agreeing at the codec level. Installed by
         tools/fetch-ffmpeg.ps1; the build does not fail without it, because the app
         reports a clear message and the tests skip. -->
    <None Include="..\..\tools\ffmpeg\**\*.*"
          Exclude="..\..\tools\ffmpeg\ffplay.exe"
          Link="ffmpeg\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
