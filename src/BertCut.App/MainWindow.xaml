<Window x:Class="BertCut.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BertCut.App"
        xmlns:input="clr-namespace:BertCut.Core.Input;assembly=BertCut.Core"
        Title="BertCut"
        Height="760" Width="1180"
        Background="#14171B"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Everything else this window draws with — the buttons, the keycaps, the cards,
             the icons — lives in Theme.xaml at application scope, because the settings
             screen is built out of the same parts. -->

        <Storyboard x:Key="HelpIn">
            <DoubleAnimation Storyboard.TargetName="HelpCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="HelpCard"
                             Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                             From="18" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="SettingsIn">
            <DoubleAnimation Storyboard.TargetName="Settings"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="Settings"
                             Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                             From="18" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="OverlaySourceIn">
            <DoubleAnimation Storyboard.TargetName="OverlaySourceCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.16" />
            <DoubleAnimation Storyboard.TargetName="OverlaySourceCard"
                             Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                             From="18" To="0" Duration="0:0:0.26">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Toolbar: the mouse-reachable half of the app. Every button here is the same
            action the keyboard reaches, dispatched through the same intent — the Tag is
            what says which — so the two can never drift apart. The reset is the exception:
            it is the one action with no key, deliberately.

            The three operations carry the colour they are drawn in on the timeline, so the
            button and the thing it made are the same colour on screen. Everything else
            stays neutral; a toolbar where everything is accented has no accent.

            Getting a video in and getting one out lead the row, in that order, where a
            wordmark used to sit. The app's name is already in the title bar and on the help
            sheet; spending the most legible corner of the window on it, in a one-window app
            you have already decided to open, bought nothing. The way in is worth more there.
        -->
        <Border Grid.Row="0" Background="#1A1E24" BorderBrush="#22272E" BorderThickness="0,0,0,1"
                Padding="10,7">
            <Grid x:Name="Toolbar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.Resources>
                    <Style x:Key="Divider" TargetType="Border">
                        <Setter Property="Width" Value="1" />
                        <Setter Property="Background" Value="#262C34" />
                        <Setter Property="Margin" Value="6,3,10,3" />
                    </Style>
                </Grid.Resources>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- The only button here with words in it. See TextIconButton. -->
                    <Button Style="{StaticResource TextIconButton}" Click="OnActionClick"
                            Tag="{x:Static input:EditorIntent.AppendSource}"
                            AutomationProperties.Name="Add video"
                            AutomationProperties.HelpText="Opens a video, or joins one onto the end of the timeline if you already have one.">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ButtonIcon}" Data="{StaticResource Icon.Add}" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Add video" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" Click="OnActionClick"
                            Content="{StaticResource Icon.Save}"
                            Tag="{x:Static input:EditorIntent.Export}"
                            AutomationProperties.Name="Save as"
                            AutomationProperties.HelpText="Write the edited video out to a new file, on the fast path where it can. Your original is never touched." />

                    <!-- Closing goes next to opening and saving, because it belongs to the
                         same question — which video is in this window — rather than to the
                         editing keys after the divider. Like the reset it has no key of its
                         own, and for the same reason: nothing that throws the whole session
                         away should be one keystroke from something that doesn't. -->
                    <Button x:Name="ClearButton" Style="{StaticResource DangerIconButton}"
                            Click="OnClearClick"
                            Content="{StaticResource Icon.Clear}"
                            AutomationProperties.Name="Close everything"
                            AutomationProperties.HelpText="Empties the window and lets go of the video files, so you can move, rename or delete them. It asks first, and your edits come back if you open the same video again." />

                    <Border Style="{StaticResource Divider}" />

                    <!-- The content of these buttons is a shape, so without an explicit
                         automation name a screen reader has nothing to announce. The same
                         name is what the tooltip prints. -->
                    <Button Style="{StaticResource IconButton}" Click="OnActionClick"
                            Content="{StaticResource Icon.MarkIn}"
                            Tag="{x:Static input:EditorIntent.MarkIn}"
                            Foreground="#4F9CF5"
                            AutomationProperties.Name="Mark in"
                            AutomationProperties.HelpText="Start of the range you are about to cut, crop or cover." />

                    <Button Style="{StaticResource IconButton}" Click="OnActionClick"
                            Content="{StaticResource Icon.MarkOut}"
                            Tag="{x:Static input:EditorIntent.MarkOut}"
                            Foreground="#4F9CF5"
                            AutomationProperties.Name="Mark out"
                            AutomationProperties.HelpText="End of the range. The strip lights up blue between the two." />

                    <Border Style="{StaticResource Divider}" />

                    <Button Style="{StaticResource IconButton}" Click="OnActionClick"
                            Content="{StaticResource Icon.RippleDelete}"
                            Tag="{x:Static input:EditorIntent.RippleDelete}"
                            Foreground="#F27B7B"
                            AutomationProperties.Name="Ripple delete"
                            AutomationProperties.HelpText="Cut the marked range out and close the gap behind it." />

                    <Button Style="{StaticResource IconButton}" Click="OnActionClick"
                            Content="{StaticResource Icon.Split}"
                            Tag="{x:Static input:EditorIntent.SplitAtPlayhead}"
                            AutomationProperties.Name="Split"
                            AutomationProperties.HelpText="Break the timeline in two at the playhead." />

                    <Button Style="{StaticResource IconButton}" Click="OnActionClick"
                            Content="{StaticResource Icon.Crop}"
                            Tag="{x:Static input:EditorIntent.BeginCrop}"
                            Foreground="#F2A14C"
                            AutomationProperties.Name="Crop and zoom"
                            AutomationProperties.HelpText="Zoom the marked range to a box you draw. With nothing marked, the whole video." />

                    <Button Style="{StaticResource IconButton}" Click="OnActionClick"
                            Content="{StaticResource Icon.Overlay}"
                            Tag="{x:Static input:EditorIntent.BeginOverlay}"
                            Foreground="#6DD48B"
                            AutomationProperties.Name="Overlay a clip"
                            AutomationProperties.HelpText="Picture-in-picture — asks what to overlay, then you aim it with the playhead." />

                    <Border Style="{StaticResource Divider}" />

                    <Button Style="{StaticResource IconButton}" Click="OnActionClick"
                            Content="{StaticResource Icon.Undo}"
                            Tag="{x:Static input:EditorIntent.Undo}"
                            AutomationProperties.Name="Undo"
                            AutomationProperties.HelpText="200 levels deep, including a reset." />

                    <Button Style="{StaticResource IconButton}" Click="OnActionClick"
                            Content="{StaticResource Icon.Redo}"
                            Tag="{x:Static input:EditorIntent.Redo}"
                            AutomationProperties.Name="Redo" />
                </StackPanel>

                <!-- What is left on the right is everything that is about the app rather
                     than about the video: throw the edits away, change the keys, read the
                     sheet. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ResetButton" Style="{StaticResource DangerIconButton}"
                            Click="OnResetClick"
                            Content="{StaticResource Icon.Reset}"
                            AutomationProperties.Name="Reset everything"
                            AutomationProperties.HelpText="Discard every edit and go back to the video as you opened it. It asks first." />

                    <Button Style="{StaticResource IconButton}" Click="OnActionClick"
                            Content="{StaticResource Icon.Settings}"
                            Tag="{x:Static input:EditorIntent.ToggleSettings}"
                            AutomationProperties.Name="Settings"
                            AutomationProperties.HelpText="Change what the keys do." />

                    <Button Style="{StaticResource IconButton}" Click="OnActionClick" Margin="0"
                            Content="{StaticResource Icon.Help}"
                            Tag="{x:Static input:EditorIntent.ToggleHelp}"
                            AutomationProperties.Name="How it works" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Preview. Nothing here is focusable, so single-letter shortcuts always reach
             the window handler. -->
        <Border Grid.Row="1" Background="#0B0D10" Margin="12,12,12,6">
            <!-- Named because it, not the Image, is what the preview's render size is worked
                 out from. An Image with Stretch="Uniform" measures to its content, so it is
                 zero-sized until the first frame arrives and would answer "how much room is
                 there?" only after the answer had already been needed. -->
            <Grid x:Name="PreviewPane">
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True" />

                <!-- Written from the key map at startup and again whenever it changes, so
                     the first thing a new user reads is the keys they actually have. -->
                <TextBlock x:Name="EmptyHint"
                           Foreground="#5C6774"
                           FontSize="14"
                           TextAlignment="Center"
                           LineHeight="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <!-- Crop and PiP handles are WPF content drawn over the video. This is the
                     requirement that ruled out an airspace-bound child window. -->
                <local:RectEditor x:Name="Placement" />

                <!--
                    Reopening a video quietly brings back the edits you made to it last
                    time. That is the right default and a bad surprise: the status bar has
                    always said so, at the very bottom of the window, in the place nobody
                    looks in the first second after a video appears. So it is said here too,
                    over the picture, where the eye already is.

                    Not hit-testable — it sits on top of the preview and the placement
                    handles, and it must not swallow a drag that was meant for either. The
                    click that dismisses it is caught at the window instead.
                -->
                <Border x:Name="RestoreToast"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="16,0,16,20"
                        Background="#F01C232D" BorderBrush="#36445C" BorderThickness="1"
                        CornerRadius="9" Padding="15,11">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>

                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Undo}"
                              Fill="#7FB4F7" Margin="0,0,12,0" VerticalAlignment="Top" />

                        <StackPanel>
                            <TextBlock x:Name="RestoreToastTitle"
                                       Foreground="#EDF2F8" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <!-- From the live key map, like everything else in this app
                                     that prints a key: telling somebody to press Ctrl+Z
                                     after they have moved undo elsewhere is worse than
                                     telling them nothing. -->
                                <ContentControl x:Name="RestoreToastKey" Style="{StaticResource KeyCap}" />
                                <TextBlock x:Name="RestoreToastHint"
                                           Foreground="#8D9BAC" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="9,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--
            Transport readout, and the transport itself.

            The controls sit here rather than in the toolbar because this is already the row
            about where you are in the video, and they are the thing that changes it. They
            are sized to the row instead of the row to them: the timecode makes it 18px tall
            and the buttons stay inside that, so adding them cost the preview nothing.

            Centred under the picture, by the oldest trick there is — an Auto column with an
            equal star on each side. The readouts either side get whatever is left, in equal
            halves, which is why the cluster lands on the centre line of the video above it
            rather than on the centre of whatever text happens to be in the row today.

            Same route as every other button in the app — an intent on the Tag, dispatched
            through Invoke — so each of these is the key it shares a name with, and the
            tooltip prints whatever that key has since been rebound to.
        -->
        <Grid x:Name="TransportRow" Grid.Row="2" Margin="12,0,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- A Grid rather than a horizontal StackPanel, so the selection has a bounded
                 width to be trimmed against instead of an infinite one. -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TimecodeLabel" Grid.Column="0"
                           Style="{StaticResource MonoText}" FontSize="15" />
                <TextBlock x:Name="SelectionLabel" Grid.Column="1" Style="{StaticResource StatusText}"
                           Margin="20,0,12,0" TextTrimming="CharacterEllipsis" />
            </Grid>

            <StackPanel x:Name="TransportControls" Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource TransportButton}" Click="OnActionClick"
                        Content="{StaticResource Icon.GoToStart}"
                        Tag="{x:Static input:EditorIntent.GoToStart}"
                        AutomationProperties.Name="Go to start" />

                <Button Style="{StaticResource TransportButton}" Click="OnActionClick"
                        Content="{StaticResource Icon.ShuttleReverse}"
                        Tag="{x:Static input:EditorIntent.ShuttleReverse}"
                        AutomationProperties.Name="Shuttle reverse"
                        AutomationProperties.HelpText="Runs backwards. Again for 2x, 4x, 8x." />

                <Button Style="{StaticResource TransportButton}" Click="OnActionClick"
                        Content="{StaticResource Icon.StepBack}"
                        Tag="{x:Static input:EditorIntent.StepBack}"
                        AutomationProperties.Name="Back one frame" />

                <!--
                    One slot, two buttons, and never both: play is meaningless while the
                    video is already running and stop is meaningless while it is not, so
                    each is hidden for exactly as long as pressing it would do nothing.
                    Collapsed rather than disabled — a greyed-out button is a thing to read
                    and dismiss, and there is no room in this row to spend on one.

                    They are the same width, so the swap happens without the cluster
                    shifting under the cursor mid-playback. OnModelChanged does the trade.
                -->
                <Button x:Name="PlayButton" Style="{StaticResource TransportPrimaryButton}"
                        Click="OnActionClick"
                        Content="{StaticResource Icon.Play}"
                        Tag="{x:Static input:EditorIntent.PlayPause}"
                        Foreground="#6DD48B"
                        AutomationProperties.Name="Play" />

                <Button x:Name="StopButton" Style="{StaticResource TransportPrimaryButton}"
                        Click="OnActionClick"
                        Visibility="Collapsed"
                        Content="{StaticResource Icon.Stop}"
                        Tag="{x:Static input:EditorIntent.Stop}"
                        Foreground="#F27B7B"
                        AutomationProperties.Name="Stop" />

                <Button Style="{StaticResource TransportButton}" Click="OnActionClick"
                        Content="{StaticResource Icon.StepForward}"
                        Tag="{x:Static input:EditorIntent.StepForward}"
                        AutomationProperties.Name="Forward one frame" />

                <Button Style="{StaticResource TransportButton}" Click="OnActionClick"
                        Content="{StaticResource Icon.ShuttleForward}"
                        Tag="{x:Static input:EditorIntent.ShuttleForward}"
                        AutomationProperties.Name="Shuttle forward"
                        AutomationProperties.HelpText="Again for 2x, 4x, 8x." />

                <Button Style="{StaticResource TransportButton}" Click="OnActionClick"
                        Content="{StaticResource Icon.GoToEnd}"
                        Tag="{x:Static input:EditorIntent.GoToEnd}"
                        AutomationProperties.Name="Go to end" />

                <!--
                    Set apart from the seven navigation chips, because it is not one of them:
                    those move the playhead, this changes only what you hear. OnModelChanged
                    swaps its glyph.
                -->
                <Button x:Name="MuteButton" Style="{StaticResource TransportButton}"
                        Click="OnActionClick"
                        Margin="14,0,1,0"
                        Content="{StaticResource Icon.Sound}"
                        Tag="{x:Static input:EditorIntent.ToggleMute}"
                        AutomationProperties.Name="Mute the preview"
                        AutomationProperties.HelpText="Monitoring only — it does not change the exported file." />
            </StackPanel>

            <TextBlock x:Name="TransportLabel" Grid.Column="2" Style="{StaticResource StatusText}"
                       HorizontalAlignment="Right" Margin="12,0,0,0" />
        </Grid>

        <local:TimelineControl x:Name="Timeline" Grid.Row="3" Margin="12,0,12,6" />

        <!-- Status bar. The transport glyph leads it: a red cross when nothing is moving,
             green chevrons pointing the way it is, one per doubling of speed. -->
        <Border Grid.Row="4" Background="#1A1E24" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Fixed width so the status text does not shift sideways as the speed
                     changes, which at 8x would be four times a second. -->
                <TextBlock x:Name="TransportIcon" Grid.Column="0"
                           Width="46" TextAlignment="Left"
                           FontFamily="Segoe UI Symbol, Segoe UI"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#FF5C5C" Text="&#x2715;"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Transport state" />

                <TextBlock x:Name="StatusLabel" Grid.Column="1" Style="{StaticResource StatusText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HintLabel" Grid.Column="2" Style="{StaticResource StatusText}"
                           Foreground="#5C6774" Text="F1 shortcuts" />
            </Grid>
        </Border>

        <!-- The help sheet. Hand-written prose for the parts that need explaining, and a
             shortcut reference generated from the same KeyMap the dispatcher resolves
             against — so the sheet cannot drift out of date with the keys. -->
        <Border x:Name="HelpOverlay"
                Grid.RowSpan="5"
                Background="#F00A0C10"
                Visibility="Collapsed"
                MouseLeftButtonDown="OnHelpBackdropClick">

            <Border x:Name="HelpCard"
                    MaxWidth="1000" MaxHeight="740" Margin="28"
                    CornerRadius="14" BorderBrush="#2E3846" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                        <GradientStop Color="#1D242E" Offset="0" />
                        <GradientStop Color="#12161C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="30,26,22,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="11" Height="11" Fill="#4F9CF5" VerticalAlignment="Center"
                                         Margin="0,0,11,0" />
                                <TextBlock Text="BertCut" FontSize="27" FontWeight="Bold" Foreground="#F3F7FC" />
                            </StackPanel>
                            <TextBlock Text="Mark a range. Then do one of three things to it."
                                       FontSize="14" Foreground="#8794A5" Margin="22,7,0,0" />
                        </StackPanel>

                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0"
                                Style="{StaticResource QuietIconButton}"
                                Content="{StaticResource Icon.Close}"
                                AutomationProperties.Name="Close" Click="OnHelpCloseClick" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="30,4,20,0" Padding="0,0,10,0"
                                  VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>

                            <!-- The loop -->
                            <TextBlock Text="THE LOOP — THREE KEYSTROKES, NO MODIFIERS"
                                       Style="{StaticResource SectionHead}" Margin="0,14,0,12" />

                            <UniformGrid Columns="4">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#1E2E46"
                                                HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock Text="1" Foreground="#7FB4F7" FontSize="12"
                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <ContentControl Style="{StaticResource KeyCap}" Content="I" Margin="0,0,0,10" />
                                        <TextBlock Text="Mark in" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Park the playhead where the boring bit starts."
                                                   Style="{StaticResource CardBody}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#1E2E46"
                                                HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock Text="2" Foreground="#7FB4F7" FontSize="12"
                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <ContentControl Style="{StaticResource KeyCap}" Content="O" Margin="0,0,0,10" />
                                        <TextBlock Text="Mark out" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Where it ends. The strip lights up blue between them."
                                                   Style="{StaticResource CardBody}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#1E2E46"
                                                HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock Text="3" Foreground="#7FB4F7" FontSize="12"
                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <ContentControl Style="{StaticResource KeyCap}" Content="X" Margin="0,0,0,10" />
                                        <TextBlock Text="Ripple delete" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="Gone, and everything after it slides left to close the gap."
                                                   Style="{StaticResource CardBody}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#2B2438"
                                                HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock Text="&#x21BA;" Foreground="#B79BE8" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ContentControl Style="{StaticResource KeyCap}" Content="Ctrl + Z"
                                                        Margin="0,0,0,10" />
                                        <TextBlock Text="Undo, always" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="200 levels deep, including a reset. Nothing here is a one-way door."
                                                   Style="{StaticResource CardBody}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- The three operations. Each accent matches the colour that
                                 operation is drawn in on the timeline. -->
                            <TextBlock Text="THE THREE OPERATIONS" Style="{StaticResource SectionHead}" />

                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <Border Height="3" Width="36" CornerRadius="2" Background="#FF5C5C"
                                                HorizontalAlignment="Left" Margin="0,0,0,14" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <ContentControl Style="{StaticResource KeyCap}" Content="X" />
                                            <ContentControl Style="{StaticResource KeyCap}" Content="Shift + Del"
                                                            Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="Cut it out" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="The marked range disappears and the timeline closes up behind it. Press ↑ and ↓ afterwards to hop between the seams and check the join." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <Border Height="3" Width="36" CornerRadius="2" Background="#F2A14C"
                                                HorizontalAlignment="Left" Margin="0,0,0,14" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <ContentControl Style="{StaticResource KeyCap}" Content="C" />
                                        </StackPanel>
                                        <TextBlock Text="Crop and zoom" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="Draw a box over the part worth seeing. For the length of the marked range it zooms to fill the frame, then reverts. With nothing marked it crops the whole video. Locked to the output ratio, so it never letterboxes." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <Border Height="3" Width="36" CornerRadius="2" Background="#6DD48B"
                                                HorizontalAlignment="Left" Margin="0,0,0,14" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <ContentControl Style="{StaticResource KeyCap}" Content="P" />
                                            <ContentControl Style="{StaticResource KeyCap}" Content="Ctrl + I"
                                                            Margin="6,0,0,0" />
                                            <ContentControl Style="{StaticResource KeyCap}" Content="A"
                                                            Margin="6,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="Overlay a clip" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="P asks what to overlay: the marked range, the segment you have selected, or a video file taken whole. That settles the clip and its length. Then move the playhead — the faint band on the strip is where it would land, and A puts it where the sound matches the base track, which for the same event filmed twice is the whole job. Enter places it, and it becomes the green band on the timeline — see below for what you can do to it there." />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- The strip. Worth its own section since the track started
                                 answering to clicks: which lane you press in decides what
                                 the press means, and that is not guessable. -->
                            <TextBlock Text="THE TIMELINE STRIP  ·  WHAT A CLICK DOES WHERE"
                                       Style="{StaticResource SectionHead}" />

                            <!-- Named so the harness can capture this section on its own:
                                 it sits below the fold of a sheet that cannot be scrolled
                                 from a script. -->
                            <UniformGrid x:Name="StripHelp" Columns="3">
                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <Border Height="3" Width="36" CornerRadius="2" Background="#8D9BAC"
                                                HorizontalAlignment="Left" Margin="0,0,0,14" />
                                        <TextBlock Text="The ruler, and the waveform"
                                                   Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="The lane above the track and the sound below it. Press or drag anywhere in either and the playhead follows — these are the only two places that move it. Nothing here selects anything, so this is also how you let go of what is selected." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <Border Height="3" Width="36" CornerRadius="2" Background="#505E70"
                                                HorizontalAlignment="Left" Margin="0,0,0,14" />
                                        <TextBlock Text="The track — your clips"
                                                   Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="Every piece the cuts have left, in alternating shades. Click one to pick it out — the playhead stays where it is, so choosing a clip never costs you your place. Delete ripples it away and closes the gap. Drag it and it changes places with its neighbours: the running order of the film, rearranged by hand." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18">
                                    <StackPanel>
                                        <Border Height="3" Width="36" CornerRadius="2" Background="#6DD48B"
                                                HorizontalAlignment="Left" Margin="0,0,0,14" />
                                        <TextBlock Text="The green band — overlays"
                                                   Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="Along the bottom of the track, wherever you have placed one. Click to pick it out, drag its middle to move it, drag either end — the darker ones — to trim it. What it shows stays put while you trim, so a synced overlay stays synced. Delete takes it off." />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Placement -->
                            <TextBlock Text="PLACING A BOX  ·  AFTER C OR P" Style="{StaticResource SectionHead}" />

                            <Border Style="{StaticResource Card}" Padding="18">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardBody}" Margin="0,0,0,14"
                                               Text="Both operations drop you into the same placement box, and both are aspect-locked — a crop to the output ratio, an overlay to its own source's — so resizing is one pair of keys instead of four. Drag the box to move it, drag a corner handle to resize it, or drag anywhere outside it to draw a new one." />
                                    <UniformGrid Columns="3">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
                                            <ContentControl Style="{StaticResource KeyCap}" Content="← ↑ → ↓" />
                                            <TextBlock Text="move" Style="{StaticResource CardBody}"
                                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
                                            <ContentControl Style="{StaticResource KeyCap}" Content="Shift + ↑ ↓" />
                                            <TextBlock Text="resize" Style="{StaticResource CardBody}"
                                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
                                            <ContentControl Style="{StaticResource KeyCap}" Content="1 – 5" />
                                            <TextBlock Text="snap to a corner or the centre"
                                                       Style="{StaticResource CardBody}"
                                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
                                            <ContentControl Style="{StaticResource KeyCap}" Content="Alt + ← →" />
                                            <TextBlock Text="slide an overlay's content to sync it"
                                                       Style="{StaticResource CardBody}"
                                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
                                            <ContentControl Style="{StaticResource KeyCap}" Content="Enter" />
                                            <TextBlock Text="apply" Style="{StaticResource CardBody}"
                                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,10,8">
                                            <ContentControl Style="{StaticResource KeyCap}" Content="Esc" />
                                            <TextBlock Text="cancel" Style="{StaticResource CardBody}"
                                                       Margin="9,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Toolbar -->
                            <TextBlock Text="THE TOOLBAR" Style="{StaticResource SectionHead}" />

                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.MarkIn}"
                                                  Fill="#4F9CF5" />
                                            <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.RippleDelete}"
                                                  Fill="#F27B7B" />
                                            <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Crop}"
                                                  Fill="#F2A14C" />
                                            <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Overlay}"
                                                  Fill="#6DD48B" />
                                        </StackPanel>
                                        <TextBlock Text="The editing icons" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="Mark in and out, cut, split, crop, overlay, undo, redo — the keys above, as buttons. Hover one and it tells you its key, whatever you have since changed that key to." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Add}"
                                                  Margin="0,0,8,0" />
                                            <TextBlock Text="Add video" Style="{StaticResource CardTitle}"
                                                       Margin="0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="The one button here with its name written on it, first in the row. Joins a file onto the end of the timeline as a new segment, scaled to the project's frame. Ctrl+A does the same." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Save}"
                                                  Margin="0,0,8,0" />
                                            <TextBlock Text="Save as" Style="{StaticResource CardTitle}"
                                                       Margin="0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="Writes the edited video out to a file you name, picking the fast path automatically. Your original is never written to. Ctrl+E does the same." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Clear}"
                                                  Fill="#FF8B8B" Margin="0,0,8,0" />
                                            <TextBlock Text="Close everything" Style="{StaticResource CardTitle}"
                                                       Margin="0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="Empties the window and lets go of the video files, so you can move, rename or delete them without closing BertCut. Your edits are saved against each video on the way out and come back when you open it again. It asks first, and it has no key." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Reset}"
                                                  Fill="#FF8B8B" Margin="0,0,8,0" />
                                            <TextBlock Text="Reset everything" Style="{StaticResource CardTitle}"
                                                       Margin="0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="Drops every cut, crop, overlay and added clip, back to the video as you opened it. It asks first, and Ctrl+Z still brings it all back. The only action with no key of its own." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Settings}"
                                                  Margin="0,0,8,0" />
                                            <TextBlock Text="Settings" Style="{StaticResource CardTitle}"
                                                       Margin="0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="Controls: every key in this sheet, and every key that places a box, on a page where you can move it somewhere that suits your hands. Ctrl+, opens it." />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Help}"
                                                  Margin="0,0,8,0" />
                                            <TextBlock Text="How it works" Style="{StaticResource CardTitle}"
                                                       Margin="0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="This sheet. F1 opens and closes it too, from anywhere — including mid-crop." />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Export -->
                            <TextBlock Text="GETTING IT OUT" Style="{StaticResource SectionHead}" />

                            <Border Style="{StaticResource Card}" Padding="18">
                                <!-- A Grid, not a horizontal StackPanel: that would hand the
                                     paragraph infinite width and it would never wrap. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Grid.Column="0" Style="{StaticResource KeyCap}"
                                                    Content="Ctrl + E"
                                                    VerticalAlignment="Top" Margin="0,2,16,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Save as" Style="{StaticResource CardTitle}" />
                                        <TextBlock Style="{StaticResource CardBody}"
                                                   Text="If you only cut, the video is copied rather than re-encoded and it runs at roughly file-copy speed. Add a crop or an overlay and only the kept frames are re-encoded. It always writes a new file — the video you opened is never modified. There is no Save button for the edits themselves: those autosave against the video's content and come back the next time you open it." />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Generated from the key map -->
                            <TextBlock Text="EVERY SHORTCUT" Style="{StaticResource SectionHead}" />

                            <ItemsControl x:Name="HelpList" Focusable="False" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Key}" Foreground="#4F9CF5"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Margin="0,0,0,12" />
                                                <ItemsControl ItemsSource="{Binding}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <!-- Wide enough for the
                                                                         longest gesture the key
                                                                         map can produce,
                                                                         Ctrl + Shift + Z. -->
                                                                    <ColumnDefinition Width="156" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <ContentControl Grid.Column="0"
                                                                                Style="{StaticResource KeyCap}"
                                                                                Content="{Binding Gesture}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Description}"
                                                                           Foreground="#96A3B3" FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="#242C36" BorderThickness="0,1,0,0" Padding="30,14">
                        <Grid>
                            <TextBlock Foreground="#6C7A8B" FontSize="12"
                                       Text="No Save button — everything autosaves against the video you opened." />
                            <TextBlock HorizontalAlignment="Right" Foreground="#4E5B6B" FontSize="12"
                                       Text="Esc or F1 to close" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- The settings screen, over the editor rather than in a window of its own: it is
             a place you go for a moment and come back from, and a second window would put
             the thing you are configuring behind it. -->
        <Border x:Name="SettingsOverlay"
                Grid.RowSpan="5"
                Background="#F00A0C10"
                Visibility="Collapsed"
                MouseLeftButtonDown="OnSettingsBackdropClick">

            <local:SettingsView x:Name="Settings" MaxWidth="1000" MaxHeight="740" Margin="28">
                <local:SettingsView.RenderTransform>
                    <TranslateTransform />
                </local:SettingsView.RenderTransform>
            </local:SettingsView>
        </Border>

        <!-- What to overlay, asked before where it goes. Placing a clip used to be one
             keypress that took its content from whichever file had been imported last and
             its length from however much of that file was left — neither ever stated, so the
             only way to learn what you were about to get was to press the key and look at
             what arrived. Three rows, and each says what it will take. -->
        <Border x:Name="OverlaySourceOverlay"
                Grid.RowSpan="5"
                Background="#F00A0C10"
                Visibility="Collapsed"
                MouseLeftButtonDown="OnOverlaySourceBackdropClick">

            <Border x:Name="OverlaySourceCard"
                    MaxWidth="620" Margin="28" Padding="30,26,30,24"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="14" BorderBrush="#2E3846" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                        <GradientStop Color="#1D242E" Offset="0" />
                        <GradientStop Color="#12161C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse Width="11" Height="11" Fill="#6DD48B" VerticalAlignment="Center"
                                 Margin="0,0,11,0" />
                        <TextBlock Text="Overlay what?" FontSize="23" FontWeight="Bold"
                                   Foreground="#F3F7FC" />
                    </StackPanel>
                    <TextBlock Text="Pick the clip. You choose where it goes next, by moving the playhead."
                               FontSize="13" Foreground="#8794A5" Margin="22,0,0,18" />

                    <!-- Each row is a button so the mouse and the digit printed on it reach
                         the same code, and a row that cannot be taken says why rather than
                         going quiet. -->
                    <Button x:Name="OverlaySourceRange" Style="{StaticResource OverlayChoice}"
                            Tag="{x:Static input:EditorIntent.ChooseOverlayMarkedRange}"
                            Click="OnOverlaySourceClick">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource KeyCap}" Content="1"
                                            VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel>
                                <TextBlock Text="The marked range" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="OverlaySourceRangeDetail"
                                           Style="{StaticResource CardBody}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OverlaySourceSegment" Style="{StaticResource OverlayChoice}"
                            Tag="{x:Static input:EditorIntent.ChooseOverlaySegment}"
                            Click="OnOverlaySourceClick">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource KeyCap}" Content="2"
                                            VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel>
                                <TextBlock Text="The selected segment" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="OverlaySourceSegmentDetail"
                                           Style="{StaticResource CardBody}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OverlaySourceFile" Style="{StaticResource OverlayChoice}"
                            Tag="{x:Static input:EditorIntent.ChooseOverlayFile}"
                            Click="OnOverlaySourceClick">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource KeyCap}" Content="3"
                                            VerticalAlignment="Center" Margin="0,0,14,0" />
                            <StackPanel>
                                <TextBlock Text="A video file" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Choose a file and overlay the whole of it — a second camera's take."
                                           Style="{StaticResource CardBody}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Esc cancels" FontSize="12" Foreground="#6B7787"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
