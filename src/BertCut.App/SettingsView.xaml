<UserControl x:Class="BertCut.App.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BertCut.App"
             Focusable="False">

    <UserControl.Resources>

        <!-- A keycap you can press. Same shape as the ones the help sheet prints, because
             it is the same thing — the difference is that this one is the control that
             changes it. -->
        <Style x:Key="KeyCapButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Margin" Value="12,0,8,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cap" Background="#232B36" BorderBrush="#3B4756" BorderThickness="1"
                                CornerRadius="4" Padding="8,4">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                       FontSize="12" Foreground="#DDE7F3" TextAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cap" Property="Background" Value="#2C3644" />
                                <Setter TargetName="Cap" Property="BorderBrush" Value="#4E5B6B" />
                            </Trigger>

                            <!-- Armed: the row is waiting for a keystroke, and it is the
                                 only thing on screen that is. -->
                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                <Setter TargetName="Cap" Property="Background" Value="#1E2E46" />
                                <Setter TargetName="Cap" Property="BorderBrush" Value="#4F9CF5" />
                                <Setter TargetName="Label" Property="Foreground" Value="#8FC0F8" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding IsUnbound}" Value="True">
                                <Setter TargetName="Cap" Property="Background" Value="#1B212A" />
                                <Setter TargetName="Cap" Property="BorderBrush" Value="#2C3540" />
                                <Setter TargetName="Label" Property="Foreground" Value="#66727F" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One page in the left-hand list. There is one of them today; the list is here so
             the second one is an entry rather than a redesign. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Chrome" CornerRadius="7" Background="Transparent" Padding="14,9" />
                            <Border x:Name="Rail" Width="3" HorizontalAlignment="Left" Margin="0,7"
                                    CornerRadius="2" Background="Transparent" />
                            <ContentPresenter Margin="14,9" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1E242D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#212A36" />
                                <Setter TargetName="Rail" Property="Background" Value="#4F9CF5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One control: what it does, the key it does it on, and a way back to the key it
             shipped on. -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:ControlRow}">
            <Grid Margin="10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="#B4C0CE" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />

                <Button Grid.Column="1" Style="{StaticResource KeyCapButton}"
                        Content="{Binding Gesture}" Click="OnCaptureClick"
                        AutomationProperties.Name="Change this key" />

                <Button Grid.Column="2" Style="{StaticResource QuietIconButton}"
                        Content="{StaticResource Icon.Reset}" Click="OnRevertClick"
                        Visibility="{Binding RevertVisibility}"
                        ToolTip="{Binding RevertTip}"
                        AutomationProperties.Name="Back to the default key" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type local:ControlSection}">
            <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHead}" />
                <Border Style="{StaticResource Card}" Padding="6,10" Margin="0,0,0,2">
                    <ItemsControl ItemsSource="{Binding Rows}"
                                  ItemTemplate="{StaticResource RowTemplate}"
                                  Focusable="False" />
                </Border>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <Border CornerRadius="14" BorderBrush="#2E3846" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                <GradientStop Color="#1D242E" Offset="0" />
                <GradientStop Color="#12161C" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="30,26,22,18">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="27" FontWeight="Bold" Foreground="#F3F7FC" />
                    <TextBlock Text="How BertCut answers to your hands."
                               FontSize="14" Foreground="#8794A5" Margin="0,7,0,0" />
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource QuietIconButton}"
                        Content="{StaticResource Icon.Close}"
                        AutomationProperties.Name="Close" Click="OnCloseClick" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="204" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#242C36" BorderThickness="0,1,1,1"
                        CornerRadius="0,10,10,0" Background="#141920" Padding="12,14">
                    <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                             Focusable="False" SelectedIndex="0"
                             ItemContainerStyle="{StaticResource NavItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Settings pages">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Settings}"
                                      Fill="#8FA1B5" Margin="0,0,10,0" />
                                <TextBlock Text="Controls" Foreground="#DDE7F3" FontSize="13"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Border>

                <ScrollViewer Grid.Column="1" Margin="26,0,14,0" Padding="0,0,10,0"
                              VerticalScrollBarVisibility="Auto" Focusable="False">
                    <!-- Held to a readable measure rather than let loose across the window:
                         on a wide screen a full-width row puts the key an inch and a half
                         from the thing it does. -->
                    <StackPanel Margin="0,2,0,16" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="Controls" FontSize="17" FontWeight="SemiBold" Foreground="#EDF2F8" />
                        <TextBlock Style="{StaticResource CardBody}" Margin="0,6,0,0"
                                   Text="Every key BertCut listens for. Click one and press the key you would rather use — Backspace takes an action off the keyboard, Esc leaves it alone. Changes save as you make them; there is no OK button here either." />

                        <ItemsControl x:Name="SectionList"
                                      ItemTemplate="{StaticResource SectionTemplate}"
                                      Focusable="False" Margin="0,0,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Footer. The left half is where a rebind says what it did, including what it
                 had to take a key away from. -->
            <Border Grid.Row="2" BorderBrush="#242C36" BorderThickness="0,1,0,0" Padding="30,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="MessageLabel" Grid.Column="0" Foreground="#8794A5" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Margin="0,0,16,0" />

                    <Button x:Name="ResetAllButton" Grid.Column="1" Style="{StaticResource DangerButton}"
                            Content="Reset every key" Click="OnResetAllClick"
                            AutomationProperties.Name="Reset every key" />

                    <TextBlock Grid.Column="2" Foreground="#4E5B6B" FontSize="12" VerticalAlignment="Center"
                               Text="Esc to close" Margin="8,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
