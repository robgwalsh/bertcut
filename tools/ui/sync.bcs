# Audio sync, end to end, in a window the user never sees and through a sound device that
# never reaches their speakers.
#
# The fixture is one recording holding the same event from two angles played back to back —
# the shape this feature exists for. The first six seconds are the first angle; the second
# six are the same event again, quieter and with its own noise.
#
# Which of the two things moves depends on which is still free. A clip being placed has content
# the user just chose, so what moves is the clip. A committed clip is where they put it, so what
# moves is which of its source's frames it reads. Both halves are below.

sample-angles angles.mp4 6
open angles.mp4
assert-has-media

# The envelope is built off the UI thread on open, so give it a moment before asking for a
# picture of the waveform. Pressing the sync key would wait on its own.
settle 1500
shot 01-waveform

# ---- placing: the clip moves ----------------------------------------------------------
#
# Mark the second angle — source frames 195 to 345 — and overlay it. That is a real range of a
# real recording, and the card takes its length from the marks: 150 frames, whatever happens
# next.
goto 195
key I
goto 345
key O

# Aim it somewhere plainly wrong, so that landing in the right place cannot be luck.
goto 40
key P
overlay-source range
assert-mode Overlay
assert-overlay-source-start 195
assert-overlay-start 40
assert-overlay-end 190
shot 02-aimed-wrong

# Sync. The same instant of the first angle is six seconds earlier, so the clip belongs at
# timeline frame 15. Bounded rather than exact: the answer is good to about a frame.
key A
assert-status Synced
assert-overlay-start 13 17
assert-overlay-source-start 195
shot 03-synced

# The playhead came with it, so the user is looking at the frame the match was made against
# rather than at wherever they left it.
assert-frame-between 13 17

# Running it again must not walk the clip somewhere else that matches equally well.
key A
assert-overlay-start 13 17

key Enter
assert-overlays 1
goto 90
shot 04-committed
state

# ---- committed: the content moves ------------------------------------------------------
#
# The other direction, on the clip that is now on the strip. Its own audio is already lined up,
# so this is the idempotent case: it reports that it is in sync and changes nothing.
goto 30
key A
assert-status sync
assert-overlays 1
state

# Muting is monitoring only: it changes what is heard, never the document.
key M
assert-muted
assert-status Muted
key M
assert-unmuted

# Playback with sound: the playhead follows the audio device's position rather than a
# stopwatch. 'sleep' blocks this thread, so the composition tick that normally drives Tick
# cannot fire — 'tick' is what stands in for it. Bounded, because it is still a real clock.
goto 0
play
sleep 600
tick
stop
assert-frame-between 5 40
state

# ---- two cameras: separate files, separate rooms ----------------------------------------
#
# The other shape, and the one the confidence gate used to refuse. Two recordings of one event
# rather than one recording holding two takes, so nothing is excluded and every offset in the
# candidate is admissible — and the two microphones agree about how loud the event was from
# moment to moment while disagreeing about the waveform underneath it. Judging that on
# near-waveform detail is what used to answer "no confident audio match" on footage the coarse
# pass had already identified outright.
#
# The far camera started rolling four seconds later and stopped with the near one, so it is
# four seconds shorter and its own frame 0 belongs at base frame 120.
reset
sample-cameras near.mp4 far.mp4 12
open near.mp4
import far.mp4
assert-has-media
settle 1500

# Overlay the whole of the far camera's recording. Its content is fixed by that choice, so
# what a sync moves here is the clip, along the timeline.
key P
overlay-source file far.mp4
assert-mode Overlay

# Aim it somewhere plainly wrong, so landing in the right place cannot be luck.
goto 20
assert-overlay-start 20
shot 05-cameras-aimed-wrong

key A
assert-status Synced
assert-overlay-start 118 122
shot 06-cameras-synced

# Idempotent here too: the tie-break toward staying put is what stops a second press walking
# the clip to somewhere that matches nearly as well.
key A
assert-overlay-start 118 122

# Shift+A is the escape hatch. With a match already applied it steps on to the next offer
# rather than repeating this one, which is the answer when the best guess was the wrong one.
key Shift+A
assert-status match
state

# ---- and when it genuinely cannot tell ---------------------------------------------------
#
# Unrelated sound, so there is nothing to find. The refusal names its best guess and its
# confidence rather than saying only that it failed: a flat no reads as a broken feature, and
# the number is the one thing that says whether it was close enough to be worth taking.
reset
sample-cameras near.mp4 far.mp4 12
sample other.mp4 8
open near.mp4
import other.mp4
settle 1500

key P
overlay-source file other.mp4
assert-mode Overlay
goto 30
key A
assert-status confident
state
